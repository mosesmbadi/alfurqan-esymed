# Afurqan Hospital -- EasyMed deployment settings.
#
# Copy to .env on the server and fill in every <...>. .env is never committed.
# docker-compose.yml reads this file both for its own ${...} values and as the
# environment of the containers.

########################## DEPLOYMENT ##########################

# Which EasyMed build to run: a full commit SHA from the easymed repo (pin
# this), or a branch tag such as `main`. The deploy workflow overwrites this
# line with the tag it deployed.
EASYMED_TAG=<easymed commit sha>
EASYMED_IMAGE_NAMESPACE=mosesmbadi

# Public host name(s) of this hospital's EasyMed, and the Let's Encrypt
# certificate directory (usually the first host name).
NGINX_SERVER_NAME=<hmis.afurqan.example www.hmis.afurqan.example>
NGINX_CERT_DOMAIN=<hmis.afurqan.example>

# Only set this when taking over volumes created under another project name
# (e.g. an existing `easymed` stack on the same server). Otherwise leave unset:
# the project is `afurqan`.
# COMPOSE_PROJECT_NAME=easymed

########################## DJANGO ##########################

SECRET_KEY=<long random string>
DJANGO_SETTINGS_MODULE=easymed.settings.production

# Never True for a hospital: True seeds fake patients, staff and stock on
# every start.
GENERATE_DEMO_DATA=False

########################## DATABASE ##########################

DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=easymed
POSTGRES_NAME=easymed
POSTGRES_USER=easymed
POSTGRES_PASSWORD=<strong password>

# Days of database dumps the backup container keeps.
BACKUP_RETENTION_DAYS=30

########################## CELERY ##########################

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

########################## EMAIL ##########################
# All required: the backend will not start without them.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=True
EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<hmis@afurqan.example>
EMAIL_HOST_PASSWORD=<smtp password>
DEFAULT_FROM_EMAIL=<hmis@afurqan.example>

########################## MONEY ##########################

CURRENCY_CODE=KES
CURRENCY_SYMBOL=KES
CURRENCY_FRACTION_DIGITS=2

########################## INTEGRATIONS ##########################
# Leave disabled until the hospital's credentials are in hand.

# KRA eTIMS
ETIMS_ENABLED=False
ETIMS_BASE_URL=
ETIMS_PIN=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_CMC_KEY=

# M-Pesa (Daraja)
MPESA_ENABLED=False
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
MPESA_SUB_ACCOUNT_ID=

# SMS (Africa's Talking)
SMS_ENABLED=False
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# WhatsApp
WHATSAPP_ENABLED=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email lab results to patients
RESULTS_EMAIL_ENABLED=False

# AI triage assistant (Google Gemini). Leave empty to switch it off.
GEMINI_API_KEY=

########################## LIS SERVER (lab analysers) ##########################
# One block per analyser. Add EQUIPMENT_2_*, EQUIPMENT_3_* as needed.

EQUIPMENT_1_ID=1
EQUIPMENT_1_IP=<analyser ip>
EQUIPMENT_1_PORT=<analyser port>
EQUIPMENT_1_TYPE=hl7
EQUIPMENT_1_NAME=<analyser name>
EQUIPMENT_1_COM_MODE=tcp

# The LIS server posts results to the backend as this EasyMed user. Create the
# user in EasyMed first.
BACKEND_USERNAME=<lis user email>
BACKEND_PASSWORD=<lis user password>
# Inside the compose network the backend is `api`.
RESULTS_ENDPOINT=http://api:8080/lab/lab-test-requests-panel/
AUTH=http://api:8080/users/login/

# Shared-directory analysers (ASTM over a network share) only.
NETWORK_EQUIPMENT_IP=
NETWORK_INPUT_WORKLIST_FILE=
NETWORK_USERNAME=
NETWORK_USER_PASSWORD=
